# ─── Global ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Database (PostgreSQL + TimescaleDB) ────────────────────────────────────
DB_USER=cmi
DB_PASSWORD=change-me
DB_NAME=cmi

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ─── Kafka ──────────────────────────────────────────────────────────────────
# (bootstrap is wired to the in-cluster broker via docker-compose)

# ─── Provider API keys ──────────────────────────────────────────────────────
COINGECKO_API_KEY=
CRYPTOCOMPARE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# X/Twitter API v2 bearer token (recent-search). Without it, collector-twitter
# is a no-op (X has no unauthenticated search endpoint).
TWITTER_BEARER_TOKEN=
# Optional: override the recent-search query (defaults to a broad crypto query).
TWITTER_QUERY=

# ─── Anthropic (Claude workers) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_ESCALATION_THRESHOLD=75

# ─── Sentiment ──────────────────────────────────────────────────────────────
SENTIMENT_MODEL=ElKulako/cryptobert

# ─── Decision / Risk tuning ─────────────────────────────────────────────────
DECISION_THRESHOLD=70
RISK_MAX_POSITION_PCT=0.05
RISK_STOP_LOSS_PCT=0.05
RISK_TAKE_PROFIT_PCT=0.10
RISK_MIN_CONFIDENCE=0.55
RISK_MIN_SCORE=70
RISK_MIN_RR=1.5

# ─── Polling intervals (seconds) ────────────────────────────────────────────
COINGECKO_POLL_INTERVAL=60
DEXSCREENER_POLL_INTERVAL=30
CRYPTOCOMPARE_POLL_INTERVAL=120
REDDIT_POLL_INTERVAL=300
TWITTER_POLL_INTERVAL=300

# ─── Scaling ────────────────────────────────────────────────────────────────
HAIKU_REPLICAS=2

# ─── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
GRAFANA_PASSWORD=admin

# ─── Traefik / TLS ──────────────────────────────────────────────────────────
ACME_EMAIL=admin@example.com

# ─── Web terminal (frontend) & WebSocket gateway ────────────────────────────
# JWT secret shared with the terminal for the WebSocket auth hook (optional in dev).
JWT_SECRET=
# 1 = standalone demo (built-in mock BFF + synthetic feed); 0 = live backend.
WEB_USE_MOCK=1
# Browser-facing WebSocket URL (baked into the client bundle at build time).
WEB_WS_URL=wss://ws.cmi.localhost/ws

# --- Claude CLI (subscription) transport for AI workers ---
# transport=cli runs `claude -p` under your OAuth subscription instead of the
# per-token Anthropic API. Set to `api` to fall back to the SDK.
ANTHROPIC_TRANSPORT=cli
ANTHROPIC_CLI_PATH=claude
ANTHROPIC_CLI_TIMEOUT_MS=120000
ANTHROPIC_CLI_CONCURRENCY=4
# Host paths to your authenticated Claude CLI credentials, mounted read-only
# into the ai-worker containers. Must contain the OAuth credential file (run
# `claude` and log in on the host first). Windows/Docker Desktop example:
CLAUDE_DIR=C:\Users\nbeny\.claude
CLAUDE_CONFIG=C:\Users\nbeny\.claude.json
