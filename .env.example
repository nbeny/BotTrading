# ─── Global ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Database (PostgreSQL + TimescaleDB) ────────────────────────────────────
DB_USER=cmi
DB_PASSWORD=change-me
DB_NAME=cmi

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ─── Kafka ──────────────────────────────────────────────────────────────────
# (bootstrap is wired to the in-cluster broker via docker-compose)

# ─── Provider API keys ──────────────────────────────────────────────────────
COINGECKO_API_KEY=
# Used by collector-news (CryptoCompare primary). Free tier ~100k calls/month.
CRYPTOCOMPARE_API_KEY=
# Used by collector-social (Reddit fallback). Optional: without creds the
# provider falls back to Reddit's public read-only .json endpoints.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ─── Anthropic (Claude workers) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6

# ─── Sentiment ──────────────────────────────────────────────────────────────
SENTIMENT_MODEL=ElKulako/cryptobert
# DB-sourced worker: how often (s) to scan raw_content for unscored rows, and
# the max rows scored per tick.
SENTIMENT_WORKER_INTERVAL=10
SENTIMENT_BATCH=100

# ─── Decision / Risk tuning ─────────────────────────────────────────────────
DECISION_THRESHOLD=70
RISK_MAX_POSITION_PCT=0.05
RISK_STOP_LOSS_PCT=0.05
RISK_TAKE_PROFIT_PCT=0.10
RISK_MIN_CONFIDENCE=0.55
RISK_MIN_SCORE=70
RISK_MIN_RR=1.5

# ─── Polling intervals (seconds) ────────────────────────────────────────────
COINGECKO_POLL_INTERVAL=60
DEXSCREENER_POLL_INTERVAL=30
SOCIAL_POLL_INTERVAL=300
NEWS_POLL_INTERVAL=300

# ─── Ingestion sources (fan-out) ────────────────────────────────────────────
# collector-social runs one adaptive poll loop per platform (Bluesky, Reddit);
# collector-news runs one per platform (CryptoCompare, RSS). Each loop self-
# throttles on its own rate limit (learned from API headers) and persists raw
# items to Postgres raw_content — no failover; a paused source resumes itself.
BLUESKY_QUERY=crypto
REDDIT_SUBREDDITS=CryptoCurrency,CryptoMoonShots,solana
# Comma-separated RSS feeds for the news floor (blank = built-in defaults:
# CoinDesk, Cointelegraph, Decrypt).
RSS_FEEDS=
# Keyless ingestion sources (Plan 2)
GDELT_QUERY=cryptocurrency
MASTODON_INSTANCE=mastodon.social
MASTODON_HASHTAG=crypto
# Add Google News to the news floor by appending its RSS URL to RSS_FEEDS, e.g.:
# RSS_FEEDS=https://news.google.com/rss/search?q=cryptocurrency
SOURCE_BREAKER_COOLDOWN=300
# Key-gated ingestion sources (Plan 3) — leave blank to disable that source
NEWSDATA_API_KEY=
NEYNAR_API_KEY=
YOUTUBE_API_KEY=
LENS_QUERY=crypto

# ─── Scaling ────────────────────────────────────────────────────────────────
HAIKU_REPLICAS=2

# ─── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
GRAFANA_PASSWORD=admin

# ─── Traefik / TLS ──────────────────────────────────────────────────────────
ACME_EMAIL=admin@example.com

# ─── Web terminal (frontend) & WebSocket gateway ────────────────────────────
# JWT secret shared with the terminal for the WebSocket auth hook (optional in dev).
JWT_SECRET=
# 1 = standalone demo (built-in mock BFF + synthetic feed); 0 = live backend.
WEB_USE_MOCK=1
# Browser-facing WebSocket URL (baked into the client bundle at build time).
WEB_WS_URL=wss://ws.cmi.localhost/ws

# --- Claude CLI (subscription) transport for AI workers ---
# transport=cli runs `claude -p` under your OAuth subscription instead of the
# per-token Anthropic API. Set to `api` to fall back to the SDK.
ANTHROPIC_TRANSPORT=cli
ANTHROPIC_CLI_PATH=claude
ANTHROPIC_CLI_TIMEOUT_MS=120000
ANTHROPIC_CLI_CONCURRENCY=4
# Host paths to your authenticated Claude CLI credentials, mounted read-only
# into the ai-worker containers. Must contain the OAuth credential file (run
# `claude` and log in on the host first). Windows/Docker Desktop example:
CLAUDE_DIR=C:\Users\nbeny\.claude
CLAUDE_CONFIG=C:\Users\nbeny\.claude.json
