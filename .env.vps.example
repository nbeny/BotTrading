# ============================================================
#  BotTrading / CMI — VPS config (Traefik + crypto.nbeny.fr)
#  Use with docker-compose.vps.yml on the VPS:
#    cp .env.vps.example .env   &&   edit the REQUIRED values
#  Generate secrets with:  openssl rand -hex 24
# ============================================================

# ------------------------------------------------------------
#  1. REQUIRED — datastore + control-plane auth
# ------------------------------------------------------------
# Postgres password (internal only; Postgres is never published).
DB_PASSWORD=change-me
# JWT signing secret — MUST match between control-api and websocket-gateway
# (both read $JWT_SECRET). Tokens minted by /auth/login are validated by the WS gateway.
JWT_SECRET=change-me
# Web-terminal admin login (mints the `admin` role → full RBAC).
CONTROL_ADMIN_USER=admin
CONTROL_ADMIN_PASSWORD=change-me

# ------------------------------------------------------------
#  2. REQUIRED for AI workers — Claude subscription auth
# ------------------------------------------------------------
# Long-lived OAuth token so the workers' `claude` CLI authenticates without a
# mounted credentials file. Generate on any logged-in machine:
#     claude setup-token
# Leave empty to disable AI analysis (the rest of the pipeline still runs, but
# decision-engine gets no worker output → no autonomous trades).
# NEVER set ANTHROPIC_API_KEY (that bills per-token instead of the subscription).
CLAUDE_CODE_OAUTH_TOKEN=

# ------------------------------------------------------------
#  3. Image registry / tag (set by CI; sensible defaults for manual runs)
# ------------------------------------------------------------
REGISTRY=ghcr.io/nbeny
TAG=latest

# ------------------------------------------------------------
#  4. Runtime knobs (sensible defaults — override only if needed)
# ------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=production
DB_USER=cmi
DB_NAME=cmi

# Memory guards for the 7.8 GB / 2-vCPU VPS.
KAFKA_HEAP_OPTS=-Xmx512m -Xms512m
HAIKU_REPLICAS=1
ANTHROPIC_CLI_CONCURRENCY=2

# Tracing is off unless you start the `observability` profile (then set this true).
OTEL_TRACING_ENABLED=false

# Trading stays in dry-run by default — no real orders. Switch to demo/live
# (and set the Kraken keys) only when you are ready.
TRADING_MODE=dry_run
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ------------------------------------------------------------
#  5. Optional — collector API keys (unset = that source is skipped)
# ------------------------------------------------------------
COINGECKO_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
NEYNAR_API_KEY=
YOUTUBE_API_KEY=
CRYPTOCOMPARE_API_KEY=
NEWSDATA_API_KEY=
RSS_FEEDS=

# ------------------------------------------------------------
#  6. Optional — observability (only used with --profile observability)
# ------------------------------------------------------------
GRAFANA_PASSWORD=admin
SENTRY_DSN=
