# ── CMI Web Terminal — environment ─────────────────────────────────────────

# FastAPI api-gateway (server-side rewrite target). The browser calls
# same-origin /api/gateway/* which Next.js proxies here.
API_GATEWAY_URL=http://localhost:8000

# Public WebSocket gateway URL used by the browser for the real-time feed
# (Kafka -> WebSocket Service -> Next.js). Overridable at runtime.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Base path the browser uses for REST (kept relative so it works behind Traefik)
NEXT_PUBLIC_API_BASE=/api/gateway

# Set to "1" to run fully standalone against the built-in mock BFF
# (Next.js route handlers under /api/mock/*) with no Python backend running.
NEXT_PUBLIC_USE_MOCK=1
