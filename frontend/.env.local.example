# ── CMI Web Terminal — environment ─────────────────────────────────────────

# FastAPI api-gateway (read-only reads). The browser calls same-origin
# /api/gateway/* which Next.js proxies here.
API_GATEWAY_URL=http://localhost:8000

# FastAPI control-api (control plane: auth + /trading/* writes). The browser
# calls same-origin /api/control/* which Next.js proxies here. In docker this is
# http://control-api:8000; for `npm run dev` against a running stack, 8001.
CONTROL_API_URL=http://localhost:8001

# Public WebSocket gateway URL used by the browser for the real-time feed
# (Kafka -> WebSocket Service -> Next.js). Overridable at runtime.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Base path the browser uses for REST (kept relative so it works behind Traefik)
NEXT_PUBLIC_API_BASE=/api/gateway

# Base path the browser uses for the control plane (auth + /trading/*)
NEXT_PUBLIC_CONTROL_BASE=/api/control

# Cloudflare Turnstile site key (public half) for the login form. Empty = no
# widget and no captcha gate, which is what you want locally: the production
# widget is bound to crypto.nbeny.fr and refuses to solve on localhost.
# Pair it with TURNSTILE_SECRET_KEY on control-api to actually enforce it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Set to "1" to run fully standalone against the built-in mock BFF
# (Next.js route handlers under /api/mock/*) with no Python backend running.
NEXT_PUBLIC_USE_MOCK=1
